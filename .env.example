APP_ENV=development
# Shown to customers when checkout or online payment fails
STORE_CONTACT_PHONE=
PAYMENT_PROVIDER=fake
DATABASE_URL=
# Public base URL for product images (WhatsApp must reach this host).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Meta App Dashboard → App settings → App secret (for X-Hub-Signature-256 on POST webhooks)
META_APP_SECRET=
# Meta Developer → WhatsApp → Configuration → Webhook → Verify token (GET challenge)
WHATSAPP_VERIFY_TOKEN=
# Optional legacy HMAC secret if META_APP_SECRET is not set
WEBHOOK_VERIFY_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
# Show WhatsApp "typing..." while the bot processes (mark read + typing indicator)
WHATSAPP_TYPING_INDICATOR=true

# Stripe
STRIPE_SECRET_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Providers (STT + QA)
OPENAI_API_KEY=
# Intent routing: multi-domain JSON classification (requires OPENAI_API_KEY; falls back to heuristics on failure).
INTENT_CLASSIFICATION_ENABLED=true
INTENT_CLASSIFICATION_MODEL=gpt-4o-mini
# Optional: override path to intent prompt template (default: src/app/prompts/intent_classification.txt)
INTENT_CLASSIFICATION_PROMPT_PATH=
# Skip LLM router and use the old question → shopping → QA flow only
INTENT_LEGACY_FLOW=false

# Catalogue vector index for intent prompt menu context (SQLite + OpenAI embeddings)
CATALOG_VECTOR_ENABLED=true
CATALOG_VECTOR_DB_PATH=data/catalog_vectors.db
CATALOG_EMBEDDING_MODEL=text-embedding-3-small
CATALOG_VECTOR_TOP_K=18
# Local Ollama (QA). If set with OPENAI_API_KEY, OpenAI is tried first; on failure, Ollama is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Recent QA turns kept per WhatsApp customer + store (in-memory; lost on process restart)
CONVERSATION_MAX_TURNS=12

# Application logging (see app.logging_setup)
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_DIRECTORY=logs
LOG_FILE_NAME=whatsapp-commerce.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Optional: override minimum level for the log file only (default: same as LOG_LEVEL)
LOG_FILE_LEVEL=
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
LOG_DATEFMT=%Y-%m-%d %H:%M:%S
# Log full OpenAI request messages + response JSON for intent classification and QA (never logs API keys)
LOG_OPENAI_DUMP_FULL=true
LOG_OPENAI_MAX_CHARS=500000
